{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "@dcloudio/types"
    ],
    "allowJs": true
  },
  "include": [
    "server/src/**/*.ts",
    "protocol/**/*.ts",
    "tests/**/*.ts",
    "tests/helpers/*.cjs"
  ]
}
